# ==============================================================================
# TechUp Digital — Environment Variables Configuration
# ==============================================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://techupdigital.in

# ------------------------------------------------------------------------------
# Email Notification Service (Resend)
# ------------------------------------------------------------------------------
# 1. Sign up at https://resend.com
# 2. Generate a private API key under the API Keys tab
# 3. Paste the key below (starts with 're_')
# NEVER prefix with NEXT_PUBLIC_ or commit real keys to source control.
RESEND_API_KEY=

# Mandatory Website Owner Recipient:
# Destination email address where all valid project inquiries are delivered.
CONTACT_OWNER_EMAIL=tchup.official@gmail.com

# Verified Sender Address:
# For development/testing before domain verification:
# TechUp Digital <onboarding@resend.dev>
# For production (once your custom domain is verified in Resend DNS):
# TechUp Digital <inquiries@techupdigital.in>
CONTACT_FROM_EMAIL=TechUp Digital <onboarding@resend.dev>

# Optional legacy fallback recipient
CONTACT_EMAIL=tchup.official@gmail.com

# ------------------------------------------------------------------------------
# Booking Integration (Optional)
# ------------------------------------------------------------------------------
# Cal.com link (e.g., "techup-digital/intro" or full Cal link)
NEXT_PUBLIC_CAL_LINK=
